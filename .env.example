# Local development only. Do not use these values in production.
# Copy this file to .env. The sample ports avoid 4317, 4318, and 3307,
# which Cursor already forwards on the owner's Windows PC.
NODE_ENV=development
CLIENT_PORT=5317
PORT=5318
LOG_LEVEL=info

DB_HOST=127.0.0.1
MYSQL_PORT=3317
DB_PORT=3317
DB_USER=gavran
DB_PASSWORD=gavran_local
DB_NAME=gavran

# Used by tests and `npm test` to create the test database if needed.
# Automated tests and CI set DB_PORT=3307 themselves. A fresh .env uses 3317.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=gavran_root_local

# Replace before any shared or production deployment. Minimum 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:5317

LOGIN_RATE_LIMIT_MAX=10
PIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional local seed. Never enable this in production.
SEED_DEV=false
SEED_OWNER_EMAIL=owner@gavran.local
SEED_OWNER_PASSWORD=change-me-local-only
SEED_OWNER_NAME=Farm Owner
